{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creator-s7:schema:skill-manifest:0.1",
  "title": "S7 skill manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "engine_api",
    "entrypoint",
    "input_schema",
    "workflow",
    "dependencies",
    "permission_file",
    "checksums",
    "runtime",
    "capabilities",
    "permissions",
    "outputs",
    "styles",
    "trust"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^s7\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "engine_api": {
      "const": "0.1"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
    },
    "input_schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
    },
    "dependencies": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
    },
    "permission_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
    },
    "checksums": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud",
        "android_local",
        "ios_local"
      ],
      "properties": {
        "cloud": {
          "type": "boolean"
        },
        "android_local": {
          "type": "boolean"
        },
        "ios_local": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "cloud": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "android_local": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "ios_local": {
              "const": true
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "script-generation",
          "voice-generation",
          "word-alignment",
          "animation",
          "video-rendering",
          "media-preview"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "project-files",
          "cloud-asset-upload",
          "text-provider-request",
          "audio-processing",
          "video-rendering",
          "artifact-download"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "video/mp4",
          "image/jpeg",
          "application/json",
          "audio/wav"
        ]
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instructions",
          "example",
          "qualification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(?:-[a-z]+)*$"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
          },
          "qualification": {
            "enum": [
              "experimental",
              "qualified"
            ]
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "redistribution"
      ],
      "properties": {
        "status": {
          "enum": [
            "unsigned-development",
            "signed-release"
          ]
        },
        "redistribution": {
          "enum": [
            "unverified",
            "approved"
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_./-]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trust": {
            "properties": {
              "status": {
                "const": "signed-release"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "trust": {
            "required": [
              "signature"
            ],
            "properties": {
              "redistribution": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ]
}
